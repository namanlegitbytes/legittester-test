{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "esnext"], "jsx": "preserve", "module": "esnext",
    "moduleResolution": "bundler", "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowJs": true, "esModuleInterop": true, "isolatedModules": true, "incremental": true,
    "resolveJsonModule": true, "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
